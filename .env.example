# Copy this file to .env before running `docker compose up --build`.
# The defaults below run the whole demonstration with no external account.
# Never commit a real credential to this repository.

# --- Database ---------------------------------------------------------------
POSTGRES_DB=organization_brain
POSTGRES_USER=organization_brain
POSTGRES_PASSWORD=organization_brain
DATABASE_URL=postgresql://organization_brain:organization_brain@db:5432/organization_brain
DB_CONNECT_TIMEOUT=5

# --- AI provider ------------------------------------------------------------
# mock              deterministic local output, no API key, no network
# openai-compatible any endpoint that speaks the OpenAI chat-completions shape
AI_PROVIDER=mock
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=example-model
AI_TIMEOUT_SECONDS=30

# --- Web --------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
INTERNAL_API_URL=http://api:8000
